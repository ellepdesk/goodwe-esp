[Unit]
Description=GoodWe inverter to MQTT (Home Assistant)
Wants=network-online.target
After=network-online.target

[Service]
# Set GOODWE_MQTT_ARGS (and MQTT_USERNAME/MQTT_PASSWORD if the broker needs them) here, e.g.
#   GOODWE_MQTT_ARGS=--hid --broker 192.168.1.10 --allow-control
EnvironmentFile=/etc/default/goodwe-mqtt
ExecStart=/usr/local/bin/goodwe-mqtt $GOODWE_MQTT_ARGS
DynamicUser=yes
# hidraw access via 99-goodwe.rules
SupplementaryGroups=plugdev
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
