; Copy to secrets.ini (git-ignored) and fill in. Strings need the escaped quotes.
[secrets]
build_flags =
    -DWIFI_SSID=\"my-wifi\"
    -DWIFI_PASSWORD=\"secret\"
    -DMQTT_HOST=\"192.168.2.201\"
